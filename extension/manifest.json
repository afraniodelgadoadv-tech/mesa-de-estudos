{
  "manifest_version": 3,
  "name": "Mesa de Estudos",
  "short_name": "Estudos",
  "version": "1.2.1",
  "description": "Cronômetro no ícone e painel lateral com tarefas, notas, estatísticas e provas da sua Mesa de Estudos.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mesa de Estudos",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "alarms",
    "storage",
    "notifications"
  ],
  "externally_connectable": {
    "matches": [
      "https://afraniodelgadoadv-tech.github.io/*"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Abrir o cronômetro"
    }
  }
}